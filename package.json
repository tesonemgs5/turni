{
  "name": "calendario-turni",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "lint": "eslint api/sheets.js src/15-quartine.js src/24-fasce-indennita.js src/25-calcoli-rotazione.js src/26-ordine-modelli.js src/27-report-modelli.js src/28-periodo-report.js src/29-periodo-sottomenu.js tests",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.118.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "terser": "^5.48.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1"
  },
  "build": {
    "appId": "com.calendarioturni.app",
    "productName": "Calendario Turni",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
